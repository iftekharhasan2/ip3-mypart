# ---------------------------------------------------------------------------
# IP3 Platform — environment
# Copy to .env for local development; set the same keys in Vercel → Settings →
# Environment Variables for production. Never commit .env.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (Network Access must allow 0.0.0.0/0 for Vercel)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ip3

# Admin session signing key — any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7
ADMIN_EMAIL=admin@ip3.org

# Administrator passphrase. Prefer the bcrypt hash in production:
#   node scripts/hash-password.js "your passphrase"
ADMIN_PASSWORD=change-this-passphrase
ADMIN_PASSWORD_HASH=

# Cloudinary CDN (Dashboard → Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ip3

# Booking defaults
MEETING_LINK=https://meet.google.com/ip3-advisory-session
MEETING_MINUTES=45

# Only needed if the frontend is hosted on a different origin than the API.
# Comma-separated allowlist; leave empty for a single-origin Vercel deployment.
CORS_ORIGIN=
# Set only when the frontend and API are on different domains.
VITE_API_BASE_URL=
